    {
      "parameters": {
        "jsCode": "const puestos = [\n  \"n8n Automation Specialist\",\n  \"Make Integration Developer\",\n  \"AI Automation Engineer\",\n  \"Backend Developer Junior\"\n];\n\nreturn puestos.map(puesto => ({\n  json: {\n    query: puesto\n  }\n}));"
      },
