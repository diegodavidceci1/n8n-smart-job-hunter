    {
      "parameters": {
        "jsCode": "const resultados = [];\nconst palabrasClave = [\"n8n\", \"make\", \"integromat\", \"zapier\", \"workflow\", \"automation\"];\n\nfor (const item of items) {\n  const { titulo = \"\", ubicacion = \"\", descripcion = \"\" } = item.json;\n\n  const tituloLower = titulo.toLowerCase();\n  const ubicacionLower = ubicacion.toLowerCase();\n  const descripcionLower = descripcion.toLowerCase();\n\n  const cumpleUbicacion = ubicacionLower.includes(\"worldwide\") || ubicacionLower.includes(\"latam\");\n\n  const noEsSenior = !tituloLower.includes(\"senior\") && !tituloLower.includes(\"lead\") && !tituloLower.includes(\"director\");\n\n  const mencionaHerramienta = palabrasClave.some(palabra => descripcionLower.includes(palabra));\n\n  if (cumpleUbicacion && noEsSenior && mencionaHerramienta) {\n    resultados.push(item);\n  }\n}\n\nreturn resultados;"
      },
      "id": "fe0c9775-aec1-4111-b661-3471b53e8fe4",
      "name": "Filtrar Ofertas Relevantes",
      "type": "n8n-nodes-base.code",
