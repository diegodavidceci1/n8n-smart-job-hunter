    {
      "parameters": {
        "jsCode": "const resultados = [];\n\nfor (const item of items) {\n  const jobs = item.json.jobs || [];\n  for (const job of jobs) {\n    resultados.push({\n      json: {\n        titulo: job.title || \"\",\n        empresa: job.company_name || \"\",\n        enlace: job.url || \"\",\n        ubicacion: job.candidate_required_location || \"\",\n        descripcion: job.description || \"\"\n      }\n    });\n  }\n}\n\nreturn resultados;"
      },
